# Copy to .env for local use. Never commit .env, never print these, never paste them into a prompt.
# The crawler needs none of them; they are for the later SERV / Reppo stages.

# SERV Reasoning (https://console.openserv.ai). OPENSERV_API_KEY is accepted as an alias.
SERV_API_KEY=

# Reppo Evaluation API (https://eval.reppo.xyz/api-key)
REPPO_API_KEY=

# Optional: Base wallet for the Reppo x402 lite route. Ask before any x402 payment.
WALLET_PRIVATE_KEY=
